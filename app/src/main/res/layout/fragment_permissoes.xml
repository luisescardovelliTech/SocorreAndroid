<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/perm_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Titulo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/perm_subtitulo"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

        <LinearLayout
            android:id="@+id/listaPermissoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/perm_fabricante_texto"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoFabricante"
            style="@style/Widget.Socorre.Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/perm_fabricante_botao" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoConcluir"
            style="@style/Widget.Socorre.Botao.Critico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/acao_concluir" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

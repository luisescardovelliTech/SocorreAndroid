<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/margem">

    <TextView
        android:id="@+id/textoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/contatos_titulo"
        android:textAppearance="@style/TextAppearance.Socorre.Titulo" />

    <TextView
        android:id="@+id/textoLimite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

    <TextView
        android:id="@+id/textoVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_grande"
        android:text="@string/contatos_vazio"
        android:textAppearance="@style/TextAppearance.Socorre.Corpo"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoAdicionar"
            style="@style/Widget.Socorre.Botao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/contato_adicionar"
            app:icon="@drawable/ic_adicionar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoImportar"
            style="@style/Widget.Socorre.Botao.Contorno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco"
            android:layout_weight="1"
            android:text="@string/contato_importar"
            app:icon="@drawable/ic_importar" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoContinuar"
        style="@style/Widget.Socorre.Botao.Critico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco"
        android:text="@string/acao_continuar"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/alerta_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Titulo" />

        <TextView
            android:id="@+id/faixaTeste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:background="@drawable/bg_faixa_teste"
            android:padding="@dimen/espaco"
            android:text="@string/teste_faixa"
            android:textColor="@color/aviso_texto"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textoResumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

        <TextView
            android:id="@+id/textoLocalizacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoMapa"
            style="@style/Widget.Socorre.Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/acao_ver_mapa"
            app:icon="@drawable/ic_rota" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/alerta_canais"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alerta_canal_sms"
                android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

            <TextView
                android:id="@+id/textoSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/envio_pendente"
                android:textAppearance="@style/TextAppearance.Socorre.Corpo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alerta_canal_api"
                android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

            <TextView
                android:id="@+id/textoApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/envio_pendente"
                android:textAppearance="@style/TextAppearance.Socorre.Corpo" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/grupoPrevia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/teste_previa_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:text="@string/teste_previa_sms"
                android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

            <TextView
                android:id="@+id/textoPreviaSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Socorre.Corpo"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:text="@string/teste_previa_destinatarios"
                android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

            <TextView
                android:id="@+id/textoPreviaDestinatarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:text="@string/teste_previa_payload"
                android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

            <TextView
                android:id="@+id/textoPreviaPayload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/texto"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoEncerrar"
            style="@style/Widget.Socorre.Botao.Critico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/acao_encerrar_emergencia"
            app:icon="@drawable/ic_check" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

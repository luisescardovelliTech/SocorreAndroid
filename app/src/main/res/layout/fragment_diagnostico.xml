<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/diag_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Titulo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/diag_explicacao"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

        <TextView
            android:id="@+id/textoDisponiveis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/diag_acelerometro"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:id="@+id/textoAcelerometro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/textoPico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoZerarPico"
            style="@style/Widget.Socorre.Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/diag_zerar_pico" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/diag_detector_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/diag_detector_explicacao"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

        <TextView
            android:id="@+id/textoDetector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/diag_giroscopio"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:id="@+id/textoGiroscopio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/diag_proximidade_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:id="@+id/textoProximidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/diag_barometro_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:id="@+id/textoBarometro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/diag_luz_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:id="@+id/textoLuz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/diag_gps_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:id="@+id/textoGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo"
            android:fontFamily="monospace" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

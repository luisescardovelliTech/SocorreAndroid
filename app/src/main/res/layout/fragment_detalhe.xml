<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/detalhe_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Titulo" />

        <!-- OpenStreetMap (osmdroid): sem chave de API. -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapa"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="@dimen/espaco"
            android:contentDescription="@string/detalhe_mapa_desc" />

        <TextView
            android:id="@+id/textoMapaIndisponivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/detalhe_mapa_indisponivel"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textoDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoAbrirMapa"
            style="@style/Widget.Socorre.Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/acao_ver_mapa"
            app:icon="@drawable/ic_rota"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

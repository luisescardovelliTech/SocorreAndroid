<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cartaoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/margem">

                <ImageView
                    android:id="@+id/iconeStatus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pausa" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margem"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textoStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/status_pausado"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textoPerfilAtual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/avisoEmergencia"
            style="@style/Widget.Socorre.Botao.Critico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/inicio_ver_emergencia"
            android:textColor="@color/sobre_emergencia"
            android:visibility="gone"
            app:backgroundTint="@color/emergencia"
            app:icon="@drawable/ic_alerta"
            app:iconTint="@color/sobre_emergencia" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/avisoContatos"
            style="@style/Widget.Socorre.Botao.Aviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/inicio_aviso_contatos"
            app:icon="@drawable/ic_aviso"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/avisoPermissoes"
            style="@style/Widget.Socorre.Botao.Aviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/inicio_aviso_permissoes"
            app:icon="@drawable/ic_aviso"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoMonitoramento"
            style="@style/Widget.Socorre.Botao.Critico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/acao_ativar_monitoramento"
            app:icon="@drawable/ic_escudo"
            app:iconGravity="textStart" />

        <com.luistech.socorre.ui.componente.BotaoPanico
            android:id="@+id/botaoPanico"
            android:layout_width="@dimen/panico"
            android:layout_height="@dimen/panico"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/espaco_grande" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/panico_ajuda"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/inicio_perfil_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCasa"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_casa"
                android:textSize="17sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBicicleta"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_bicicleta"
                android:textSize="17sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoto"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_moto"
                android:textSize="17sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCampo"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_campo"
                android:textSize="17sp" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cartaoClima"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            app:cardBackgroundColor="@color/superficie">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/clima_card_titulo"
                    android:textAppearance="@style/TextAppearance.Socorre.Secao" />

                <TextView
                    android:id="@+id/textoClima"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/clima_carregando"
                    android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

                <TextView
                    android:id="@+id/textoClimaAvisos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progressoTrajeto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/espaco"
            android:contentDescription="@string/clima_verificando"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoTrajeto"
            style="@style/Widget.Socorre.Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/acao_iniciar_trajeto"
            app:icon="@drawable/ic_rota" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

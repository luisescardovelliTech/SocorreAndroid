<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaco"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/superficie">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/textoPrioridade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:id="@+id/textoDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoSubir"
                style="@style/Widget.Socorre.Icone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_subir" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoDescer"
                style="@style/Widget.Socorre.Icone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_descer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoTestar"
                style="@style/Widget.Socorre.Icone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_sms" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoRemover"
                style="@style/Widget.Socorre.Icone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_remover" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

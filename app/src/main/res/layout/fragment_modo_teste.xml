<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/teste_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Titulo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:background="@drawable/bg_faixa_teste"
            android:padding="@dimen/margem"
            android:text="@string/teste_aviso"
            android:textColor="@color/aviso_texto"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/teste_explicacao"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chaveBrusco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:minHeight="48dp"
            android:text="@string/teste_brusco" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/teste_brusco_ajuda"
            android:textAppearance="@style/TextAppearance.Socorre.Corpo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSimularQueda"
            style="@style/Widget.Socorre.Botao.Critico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/teste_simular_queda" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSimularPanico"
            style="@style/Widget.Socorre.Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/teste_simular_panico" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSimularCheckin"
            style="@style/Widget.Socorre.Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/teste_simular_checkin" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

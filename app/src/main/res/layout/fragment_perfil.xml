<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/perfil_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Titulo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imagemFoto"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/perfil_foto_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pessoa" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoFoto"
                style="@style/Widget.Socorre.Botao.Contorno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margem"
                android:layout_weight="1"
                android:text="@string/perfil_foto" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:hint="@string/perfil_nome">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_padrao"
                android:inputType="textPersonName|textCapWords"
                android:textSize="18sp"
                android:autofillHints="name" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:hint="@string/perfil_telefone"
            app:helperText="@string/perfil_telefone_ajuda">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoTelefone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_padrao"
                android:inputType="phone"
                android:textSize="18sp"
                android:autofillHints="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNascimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:hint="@string/perfil_nascimento">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoNascimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_padrao"
                android:inputType="none"
                android:textSize="18sp"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/perfil_atividade"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/perfil_atividade_ajuda"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCasa"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_casa"
                android:textSize="17sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBicicleta"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_bicicleta"
                android:textSize="17sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoto"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_moto"
                android:textSize="17sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCampo"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_campo"
                android:textSize="17sp" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:accessibilityHeading="true"
            android:text="@string/perfil_ficha_titulo"
            android:textAppearance="@style/TextAppearance.Socorre.Secao" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/perfil_ficha_explicacao"
            android:textAppearance="@style/TextAppearance.Socorre.Apoio" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchGuardarFicha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:minHeight="@dimen/toque_minimo"
            android:text="@string/perfil_ficha_consentimento"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/grupoFicha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:hint="@string/perfil_tipo_sanguineo">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/campoTipoSanguineo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:minHeight="@dimen/toque_padrao"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutAlergias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:hint="@string/perfil_alergias">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoAlergias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/toque_padrao"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMedicamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:hint="@string/perfil_medicamentos">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoMedicamentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/toque_padrao"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCondicoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:hint="@string/perfil_condicoes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoCondicoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/toque_padrao"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCompartilharFicha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:minHeight="@dimen/toque_minimo"
                android:text="@string/perfil_ficha_compartilhar"
                android:textSize="17sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoSalvar"
            style="@style/Widget.Socorre.Botao.Critico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/acao_salvar" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
